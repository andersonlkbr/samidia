# ============================
# SAmídia - Variáveis de Ambiente
# ============================
# Copie este arquivo como .env e preencha os valores

# Porta do servidor (padrão: 3000)
PORT=3000

# Cloudflare R2 (Storage de Mídias)
R2_ENDPOINT=https://xxxxxxxxxx.r2.cloudflarestorage.com
R2_ACCESS_KEY=sua_access_key_aqui
R2_SECRET_KEY=sua_secret_key_aqui
R2_BUCKET=nome-do-bucket
R2_PUBLIC_URL=https://seu-dominio-publico-r2.com

# OpenWeather API (Previsão do Tempo)
OPENWEATHER_API_KEY=sua_chave_openweather_aqui

# JWT (Autenticação)
JWT_SECRET=sua_chave_secreta_jwt_aqui
JWT_EXPIRES_IN=7d
